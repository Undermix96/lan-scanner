# Copy to .env and edit: cp .env.example .env
# Any variable left out uses the default from docker-compose.yml.

# "auto" = scan the host's networks; or a comma list, e.g. 192.168.1.0/24,10.0.0.0/24
SCAN_TARGETS=auto
# Minutes between automatic scans (0 = manual only)
SCAN_INTERVAL_MINUTES=60
# Web UI port
WEB_PORT=8080
# nmap arguments for the port scan (e.g. "-p- -sV" for all ports)
NMAP_PORT_ARGS="--top-ports 1000 -sV --version-light -T4"
# Enable OS detection (-O)
NMAP_OS_DETECT=false
# Max time spent on each host
NMAP_HOST_TIMEOUT=5m
